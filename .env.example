# Copy this file to .env.local and fill in the values.
# Ask a maintainer for access. Never commit .env.local.

LINEAR_API_KEY=your-linear-personal-api-key
LINEAR_TEAM_KEY=SHU

# Supabase public values (safe for the app). Never add the secret key here.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# The site's own address, which search and share links name. This value works on this machine.
SITE_URL=http://localhost:5173

# The weekly database backup (npm run backup) asks for its passphrase, which lives in the password
# manager. Leave this out, so the key to the backups never sits on the same machine as the backups.
# BACKUP_PASSPHRASE=
