# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase public values (safe for the app). Never add the secret key here.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# The site's own address, which search and share links name. Locally, the dev server's address.
SITE_URL=http://localhost:5173
